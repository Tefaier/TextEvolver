POSTGRES_DB=text_evolver
POSTGRES_USER=text_evolver
POSTGRES_PASSWORD=replace-with-a-long-database-password
DATABASE_URL=postgresql+psycopg://text_evolver:replace-with-a-long-database-password@localhost:6432/text_evolver
SECRET_KEY=replace-with-at-least-32-random-characters
PASSWORD_KEY_CURRENT=replace-with-base64-encoded-32-byte-key
PASSWORD_KEY_CURRENT_VERSION=1
PASSWORD_KEY_PREVIOUS=
PASSWORD_KEY_PREVIOUS_VERSION=
APP_PORT=8000
WORK_ROOT=var/work
TEMP_ROOT=var/tmp
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=text-evolver-user-images
S3_REGION=us-east-1
S3_ACCESS_KEY=text-evolver-minio
S3_SECRET_KEY=replace-with-a-long-minio-secret
S3_FORCE_PATH_STYLE=true
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
CHROME_BINARY=
SELENIUMBASE_DRIVER_ROOT=var/seleniumbase
COOKIE_SECURE=false
UPLOAD_LIMIT_BYTES=26214400
SETTING_LIMIT_BYTES=536870912
WORKER_POLL_SECONDS=2
WORKER_CONCURRENCY=1
WORKER_CANCEL_POLL_SECONDS=0.5
WORKER_MIN_FREE_MEMORY_BYTES=805306368
JOB_STALE_SECONDS=300
RESULTS_PER_PAGE=50
